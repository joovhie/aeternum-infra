# CAMPAIGN — APP-SPECIFIC ENVIRONMENT VARIABLES
# Shared variables (CHAIN_ID, RPC_URL, CONTRACT_ADDRESS, DATABASE_URL)
# are inherited from the root .env via dotenv-cli in the dev script.
# On Render, they're injected via the shared environment group.

# --- HTTP ---
PORT=3002

# --- Reward weighting (see build plan: "Reward parameters") ---
# Multiplier on mainnet-phase points vs Sepolia's 1x baseline. TBD.
CAMPAIGN_MAINNET_WEIGHT_MULTIPLIER=3

# Minimum real deposit (wei) to earn the mainnet registration bonus. TBD.
CAMPAIGN_DEPOSIT_DUST_THRESHOLD_WEI=1000000000000000

# Seconds a deposit must remain before counting toward points.
CAMPAIGN_MIN_HOLD_SECONDS=86400

# Points -> ETH conversion rate, wei per point. Leave at 0 until this is
# deliberately set — see src/redemption/executor.ts.
CAMPAIGN_POINTS_TO_WEI_RATE=0

# Set to "true" once apps/indexer is actually tracking mainnet. Gates the
# mainnet registration scoring and monthly liveness checkpoint jobs.
MAINNET_INDEXING_LIVE=false

# Total ETH (wei) available for redemption payouts. Locked at seed close.
CAMPAIGN_TREASURY_BUDGET_WEI=0

# --- Treasury ---
# Safe (multisig) address holding redemption funds. Required before any
# payout can be proposed — see src/redemption/treasury.ts.
CAMPAIGN_TREASURY_SAFE_ADDRESS=YourSafeAddressHere

# Placeholder shared-secret for the admin-only redemption approval route.
# Not real auth — see env.ts.
CAMPAIGN_ADMIN_API_KEY=YourAdminKeyHere

# --- Galxe ---
# From Galxe dashboard: Settings -> Accounts -> Access Tokens.
GALXE_ACCESS_TOKEN=YourGalxeAccessToken
GALXE_SPACE_ID=YourGalxeSpaceId
GALXE_CAMPAIGN_ID=YourGalxeCampaignId
GALXE_API_URL=https://graphigo-business.prd.galaxy.eco/query
